extends layout

block content

  h1.mb-4
    | Interesados en "#{post.title}"

  if interests.length === 0

    .alert.alert-secondary
      | Nadie marcó interés todavía

  else

    each interest in interests

      .card.mb-2

        .card-body.d-flex.justify-content-between.align-items-center

          strong= interest.User.username

          a.btn.btn-primary.btn-sm(
            href=`/messages/${interest.User.id}`
          ) Enviar mensaje