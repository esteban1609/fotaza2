extends layout

block content

  h1.mb-4
    = collection.name

  if collection.CollectionPosts.length === 0

    .alert.alert-secondary
      | Esta colección está vacía

  else

    .row

      each item in collection.CollectionPosts

        .col-md-6.col-lg-4.mb-4

          .card.shadow-sm.h-100

            img.card-img-top(
              src=item.Post.image
              style="height: 220px; object-fit: cover;"
            )

            .card-body

              h5.card-title
                = item.Post.title

              p.card-text.text-muted
                = item.Post.description

            form(
              action=`/collections/${collection.id}/remove/${item.Post.id}`
              method="POST"
              class="mt-3"
            )
              button.btn.btn-sm.btn-outline-danger(
                type="submit"
                onclick="return confirm('¿Quitar esta publicación de la colección?')"
              )
                i.bi.bi-trash
                |  Quitar de colección    