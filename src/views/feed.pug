extends layout


block content

  h1.mb-4 Feed de publicaciones
  
  if posts.length === 0

    .alert.alert-warning.text-center

      h4.mb-2
        | No se encontraron publicaciones

      p.mb-0
        | Probá con otra búsqueda

  each post in posts

    .card.feed-card.mb-4.shadow-sm

      .card-body

        

        .d-flex.justify-content-between.align-items-center.mb-3
        

          .d-flex.align-items-center

            if post.User && post.User.profile_image

              img.rounded-circle.me-3(
                src=post.User.profile_image
                width="50"
                height="50"
              )

            else

              i.bi.bi-person-circle.fs-1.me-3

            div

              if post.User

                a.fw-bold.text-decoration-none(
                  href=`/users/${post.User.id}`
                )

                  = post.User.username

              else

                span Usuario desconocido

              br

              small.text-muted

                = post.createdAt.toLocaleDateString()
            
          if currentUser && currentUser.id === post.UserId
            
            .dropdown
              button.btn.btn-sm.btn-light(
                type="button"
                data-bs-toggle="dropdown"
              )
                i.bi.bi-three-dots-vertical

              ul.dropdown-menu.dropdown-menu-end
                li
                  a.dropdown-item(href=`/posts/${post.id}/interests`)
                    | Ver interesados

                li
                  a.dropdown-item(href=`/comments/reports/${post.id}`)
                    | Ver denuncias de comentarios

                li
                  form(action=`/posts/toggle-comments/${post.id}` method="POST")
                    button.dropdown-item(type="submit")
                      if post.commentsEnabled
                        | Cerrar comentarios
                      else
                        | Abrir comentarios

          else
            details.mt-2
              summary.text-danger(style="cursor:pointer")
                i.bi.bi-flag.me-1
                | Denunciar publicación

              form.mt-2(action=`/reports/${post.id}` method="POST")
                select.form-select.mb-2(name="reason" required)
                  option(value="" disabled selected) Motivo de denuncia
                  option(value="Copyright") Copyright
                  option(value="Contenido inapropiado") Contenido inapropiado
                  option(value="Spam") Spam
                  option(value="Contenido ofensivo") Contenido ofensivo
                  option(value="Otro") Otro

                textarea.form-control.mb-2(
                  name="description"
                  placeholder="Explicá el motivo de la denuncia"
                  rows="2"
                  required
                )

                button.btn.btn-danger.btn-sm(type="submit")
                  | Enviar denuncia

        h2.card-title.mb-2

          = post.title

        p.card-text

          = post.description

        if post.tags

          p.mb-3

            each tag in post.tags.split(",")

              span.badge.bg-primary.me-1

                | ##{tag.trim()}

       
        if post.copyright
          p.text-danger.mb-2
            | © Copyright protegido
        else
          p.text-success.mb-2
            | Libre de copyright

       
        p.fw-bold.mb-2
          | Valoración:

          each star in [1, 2, 3, 4, 5]
            if star <= post.get("roundedAverage")
              span.text-warning ⭐
            else
              span.text-secondary ☆

          |  (#{post.get("averageRating")})




        .d-flex.gap-4.mb-3.mt-3

          span

            | 💬 #{post.Comments.length}

          span

            | ❤️ #{post.Interests.length}

        - const isFavorite = favorites.some(favorite => favorite.PostId === post.id)

        form(
          action=`/favorites/${post.id}`
          method="POST"
          class="d-inline"
        )

          if isFavorite

            button.btn.btn-danger(
              type="submit"
              formaction=`/favorites/remove/${post.id}`
              title="Quitar de favoritos"
            )

              i.bi.bi-heart-fill

          else

            button.btn.btn-outline-danger(
              type="submit"
              title="Agregar a favoritos"
            )

              i.bi.bi-heart

        form(
          action="/collections/add"
          method="POST"
        )
          input(
            type="hidden"
            name="postId"
            value=post.id
          )

          select.form-select.mb-2(
            name="collectionId"
            required
          )
            each collection in collections
              option(value=collection.id)
                = collection.name

          button.btn.btn-outline-dark(
            type="submit"
          )
            | Guardar 
        
        - const hasInterest = currentUser && post.Interests.some(interest => interest.UserId === currentUser.id)

        if currentUser && post.UserId !== currentUser.id
          if hasInterest
            a.btn.btn-primary.btn-sm.mt-2(
              href=`/messages/${post.UserId}`
            )
              i.bi.bi-chat-dots.me-1
              | Enviar mensaje al autor
          else
            form(
              action=`/interest/${post.id}`
              method="POST"
              class="mt-2"
            )
              button.btn.btn-info(type="submit")
                | Me interesa
        

        .image-container.mt-3.mb-3

          .image-background(
            style=`background-image: url('${post.image}')`
          )

          img.feed-image.rounded(
            src=post.image
          )

        h3 Comentarios

        
        each comment in post.Comments

          .d-flex.align-items-center.mb-2

            if comment.User.profile_image

              img.rounded-circle.me-2(
                src=comment.User.profile_image
                width="30"
                height="30"
              )

            strong #{comment.User.username}:

            span.ms-2
              = comment.content

            if currentUser && currentUser.id === comment.UserId

              form(
                action=`/comments/delete/${comment.id}`
                method="POST"
                class="ms-2"
              )
                button.btn.btn-sm.btn-outline-danger(
                  type="submit"
                  onclick="return confirm('¿Eliminar este comentario?')"
                )
                  i.bi.bi-trash

            else if currentUser

              details.ms-2
                summary.text-danger(style="cursor:pointer")
                  i.bi.bi-flag

                form.mt-2(
                  action=`/comments/report/${comment.id}`
                  method="POST"
                )

                  select.form-select.form-select-sm.mb-2(
                    name="reason"
                    required
                  )
                    option(value="" disabled selected) Motivo de denuncia
                    option(value="Spam") Spam
                    option(value="Contenido ofensivo") Contenido ofensivo
                    option(value="Acoso") Acoso
                    option(value="Contenido inapropiado") Contenido inapropiado
                    option(value="Otro") Otro

                  textarea.form-control.form-control-sm.mb-2(
                    name="description"
                    placeholder="Explicá el motivo de la denuncia"
                    rows="2"
                    required
                  )

                  button.btn.btn-sm.btn-danger(type="submit")
                    | Enviar denuncia


        if post.commentsEnabled
          
          form(
            action=`/comments/create/${post.id}`
            method="POST"
            class="mt-3"
          )

            textarea.form-control.mb-2(
              name="content"
              placeholder="Escribí un comentario"
              rows="3"
            )

            button.btn.btn-success(type="submit")
              | Comentar

        else

          p.text-danger

            | Comentarios cerrados por el autor
        
        br

        form(
          action=`/ratings/create/${post.id}`
          method="POST"
          class="mt-2"
        )

          select.form-select.mb-2(name="value")

            option(value="1") 1 estrella
            option(value="2") 2 estrellas
            option(value="3") 3 estrellas
            option(value="4") 4 estrellas
            option(value="5") 5 estrellas

          button.btn.btn-warning(type="submit")
            | Valorar