nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.shadow-sm

  .container

    a.navbar-brand(href="/")
      | Fotaza

    button.navbar-toggler(
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
    )

      span.navbar-toggler-icon

    .collapse.navbar-collapse#navbarNav

      ul.navbar-nav.me-auto

        li.nav-item

          a.nav-link(href="/")

            i.bi.bi-house-fill.me-1

            | Feed

        li.nav-item

          a.nav-link(href="/posts/create")

            i.bi.bi-plus-circle-fill.me-1

            | Publicar

        li.nav-item

          a.nav-link(href="/collections")

            i.bi.bi-folder-fill.me-1

            | Colecciones

        li.nav-item

          a.nav-link(href="/favorites")

            i.bi.bi-heart-fill.me-1

            | Favoritos
        
        li.nav-item

          a.nav-link(href="/messages")

            i.bi.bi-chat-dots-fill.me-1

            | Mensajes

        li.nav-item

          a.nav-link(href="/following-posts")

            i.bi.bi-people-fill.me-1

            | Siguiendo

      .d-flex.align-items-center.me-3

        form.d-flex.me-2(
          action="/search"
          method="GET"
        )
          input.form-control.me-2(
            type="search"
            name="q"
            placeholder="Búsqueda general"
          )

          button.btn.btn-outline-light(
            type="submit"
          )
            i.bi.bi-search

        .dropdown

          button.btn.btn-outline-light(
            type="button"
            id="filterDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            title="Filtros avanzados"
          )
            i.bi.bi-sliders

          .dropdown-menu.dropdown-menu-end.p-3(
            aria-labelledby="filterDropdown"
            style="width: 300px;"
          )

            form(
              action="/search"
              method="GET"
            )

              h6.mb-3 Filtros avanzados

              label.form-label Título
              input.form-control.mb-2(
                type="text"
                name="title"
                placeholder="Título"
              )

              label.form-label Descripción
              input.form-control.mb-2(
                type="text"
                name="description"
                placeholder="Descripción"
              )

              label.form-label Usuario
              input.form-control.mb-2(
                type="text"
                name="username"
                placeholder="Autor"
              )

              label.form-label Etiqueta
              input.form-control.mb-2(
                type="text"
                name="tag"
                placeholder="Etiqueta"
              )

              label.form-label Licencia

              select.form-select.mb-3(name="copyright")
                option(value="") Todas
                option(value="true") Con copyright
                option(value="false") Sin copyright

              button.btn.btn-primary.w-100(type="submit")
                | Aplicar filtros

      button#theme-toggle.btn.btn-outline-light.me-3

        i.bi.bi-moon-fill

      a.nav-link.text-light.me-3(
        href="/notifications"
      )

        i.bi.bi-bell-fill

        if unreadNotifications > 0

          span.ms-1

            | (#{unreadNotifications})

      if currentUser

        a.nav-link.text-light.me-3(
          href=`/users/${currentUser.id}`
        )

          if currentUser.profile_image

            img.rounded-circle.border.border-light(
              src=currentUser.profile_image
              width="40"
              height="40"
            )

          else

            i.bi.bi-person-circle.fs-4.text-light

      a.nav-link.text-danger(
        href="/logout"
      )

        i.bi.bi-box-arrow-right