
extends layout

block content
  h1.mb-4 Cola de revisión

  if reportedPosts.length === 0
    .alert.alert-success
      | No hay publicaciones pendientes de revisión.

  each group in reportedPosts
    .card.mb-4
      .card-body
        h4.mb-2= group.post.title

        p.text-muted
          | Publicado por: #{group.post.User.username}

        p
          strong Usuarios que denunciaron:
          |  #{group.reporterCount}

        hr

        h5 Denuncias recibidas

        each report in group.reports
          .border.rounded.p-3.mb-2
            p.mb-1
              strong Motivo:
              |  #{report.reason}
            p.mb-1
              strong Descripción:
              |  #{report.description}
            p.text-muted.mb-0
              | Denunciado por: #{report.User.username}

        .d-flex.gap-2.mt-3
          form(action=`/posts/delete/${group.post.id}` method="POST")
            button.btn.btn-danger(
              type="submit"
              onclick="return confirm('¿Estás seguro de dar de baja esta publicación?')"
            )
              i.bi.bi-trash.me-1
              | Dar de baja publicación

          form(action=`/reports/${group.post.id}/dismiss` method="POST")
            button.btn.btn-secondary(type="submit")
              i.bi.bi-x-circle.me-1
              | Desestimar denuncias
